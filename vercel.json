{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control", "value": "public, max-age=0, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/sound-effects.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/Amr_Waled_CV.pdf",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" },
        { "key": "Content-Disposition", "value": "inline; filename=\"Amr_Waled_CV.pdf\"" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=1800" }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt|CLAUDE_CONTEXT.md|robots.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=1800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/brand", "destination": "/brand" },
    { "source": "/plan", "destination": "/brand" },
    { "source": "/personal-branding", "destination": "/brand" },
    { "source": "/en", "destination": "/en" },
    { "source": "/about", "destination": "/about" },
    { "source": "/systems", "destination": "/systems" },
    { "source": "/solutions", "destination": "/solutions" },
    { "source": "/engaz", "destination": "/engaz-case-study" },
    { "source": "/case-study", "destination": "/engaz-case-study" },
    { "source": "/engaz-case-study", "destination": "/engaz-case-study" },
    { "source": "/geo", "destination": "/geo-2026" },
    { "source": "/geo-2026", "destination": "/geo-2026" },
    { "source": "/playbook", "destination": "/GEO_Amr_waled" },
    { "source": "/GEO_Amr_waled", "destination": "/GEO_Amr_waled" },
    { "source": "/vibe-coding-playbook", "destination": "/vibe-coding-playbook" },
    { "source": "/media-buyer-ai-playbook", "destination": "/media-buyer-ai-playbook" },
    { "source": "/crm", "destination": "/crm-systems" },
    { "source": "/crm-systems", "destination": "/crm-systems" },
    { "source": "/clinic", "destination": "/insight-clinic-case-study" },
    { "source": "/insight-clinic", "destination": "/insight-clinic-case-study" },
    { "source": "/insight-clinic-case-study", "destination": "/insight-clinic-case-study" },
    { "source": "/marketing-tanta", "destination": "/marketing-tanta" },
    { "source": "/tanta", "destination": "/marketing-tanta" }
  ]
}
